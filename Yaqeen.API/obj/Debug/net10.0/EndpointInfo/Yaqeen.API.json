{
  "openapi": "3.0.4",
  "info": {
    "title": "Yaqeen.API",
    "version": "1.0"
  },
  "paths": {
    "/api/yaqeen/citizen/validate": {
      "post": {
        "tags": [
          "Citizen"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateCitizenRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateCitizenRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateCitizenRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
