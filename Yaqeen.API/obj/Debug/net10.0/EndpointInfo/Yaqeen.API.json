        "parameters": [
          {
            "name": "sequenceNumber",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nationalId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/VehicleInquiry/inquire": {
      "post": {
        "tags": [
          "VehicleInquiry"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VehicleInquiryRequestDto"
