            "name": "nationalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/yaqeen/vehicle/{sequenceNumber}": {
      "get": {
        "tags": [
          "Vehicle"
        ],
        "parameters": [
          {
            "name": "sequenceNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/yaqeen/vehicle/plate": {
      "get": {
        "tags": [
          "Vehicle"
        ],
        "parameters": [
          {
            "name": "PlateNumber",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "PlateLetters",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
