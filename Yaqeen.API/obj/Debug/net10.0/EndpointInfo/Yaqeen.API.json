        "additionalProperties": false
      },
      "VehicleInquiryRequestDto": {
        "type": "object",
        "properties": {
          "nationalId": {
            "type": "string",
            "nullable": true
          },
          "sequenceNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
